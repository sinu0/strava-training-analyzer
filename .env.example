# === Database ===
DB_PASSWORD=change-me-in-prod

# === Strava OAuth2 ===
STRAVA_CLIENT_ID=your-client-id
STRAVA_CLIENT_SECRET=your-client-secret
STRAVA_WEBHOOK_TOKEN=random-webhook-verify-token

# === Security ===
JWT_SECRET=change-me-random-32-char-secret
ENCRYPTION_KEY=change-me-random-32-byte-hex-key

# Aplikacja jest domyślnie local-only. Włącz dokładnie te adaptery, których używasz.
# Dla Ollama w Compose ustaw AI_ENABLED=true, AI_OLLAMA_ENABLED=true oraz
# COMPOSE_PROFILES=ai. Adres `ollama` działa z kontenera backendu.
AI_ENABLED=false
AI_PROVIDER=ollama
AI_MODEL=qwen3.6:27b
AI_OLLAMA_ENABLED=false
AI_OLLAMA_URL=http://ollama:11434
AI_OPENAI_ENABLED=false
AI_OPENAI_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=
AI_ANTHROPIC_ENABLED=false
AI_ANTHROPIC_URL=https://api.anthropic.com
AI_ANTHROPIC_API_KEY=
AI_GEMINI_ENABLED=false
AI_GEMINI_API_KEY=
AI_AZURE_OPENAI_ENABLED=false
AI_AZURE_OPENAI_URL=
AI_AZURE_OPENAI_API_KEY=
AI_AZURE_OPENAI_DEPLOYMENT=
AI_AZURE_OPENAI_API_VERSION=2024-02-01
AI_BATCH_ENABLED=true
AI_BATCH_CRON=0 0 3 * * *
AI_KNOWLEDGE_ENABLED=false
AI_KNOWLEDGE_CRON=0 0 2 * * 0
AI_NOTE_QUEUE_INTERVAL=30000
AI_EMBEDDING_MODEL=all-minilm
AI_VALIDATION_MINIMUM_SAMPLES=20
COMPOSE_PROFILES=
